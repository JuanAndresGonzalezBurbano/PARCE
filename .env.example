# ==============================================================================
# P.A.R.C.E — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
#
# For a PRODUCTION deployment, at minimum change:
#   APP_ENV=production, APP_DEBUG=false, APP_URL, DB_* (real credentials),
#   CORS_ALLOWED_ORIGINS (real frontend domain — see note below).
# ==============================================================================

# Application Configuration
APP_NAME="P.A.R.C.E"
APP_ENV=local
# APP_DEBUG=true exposes stack traces/file paths/error messages in API
# responses (see App::handleException()) — MUST be false in production.
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parce
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
# SESSION_LIFETIME: absolute session lifetime in seconds (also used as the
# session cookie's max-age). Default in code: 7200 (2h) via CookieConfig,
# or the SessionManager absolute-timeout default if unset here.
SESSION_LIFETIME=120
# SESSION_IDLE_TIMEOUT: seconds of inactivity before a session is considered
# expired, independent of SESSION_LIFETIME. Optional — has a code default.
# SESSION_IDLE_TIMEOUT=1800
# SESSION_REGENERATE_INTERVAL: seconds between automatic session ID
# regeneration (anti session-fixation). Optional — code default is 600.
# SESSION_REGENERATE_INTERVAL=600

# Session Cookie Configuration (all optional — CookieConfig::fromEnv() has
# secure defaults for every one of these if left unset)
# SESSION_COOKIE_NAME=parce_session
# SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_SECURE=auto      # auto|true|false — 'auto' detects HTTPS
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax     # Strict|Lax|None

# CORS Configuration
# CORS_ALLOWED_ORIGINS: comma-separated list of allowed frontend origins.
# If unset, CORSMiddleware falls back to localhost dev origins only
# (http://localhost:3000,5173,8080) — MUST be set to the real frontend
# domain(s) in production, or the production frontend will be blocked by CORS.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CORS_ALLOW_CREDENTIALS=true
# CORS_MAX_AGE=86400

# Password reset emails (Resend — https://resend.com)
# RESEND_API_KEY: without this, MailerService::send() fails safely (logs a
# warning, returns false) — forgot-password still responds normally to the
# client (no email enumeration), it just won't actually deliver an email.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM: must be a domain verified in your Resend account in production.
# The Resend sandbox address below only works for testing, not real delivery.
# MAIL_FROM="P.A.R.C.E <onboarding@resend.dev>"
# APP_FRONTEND_URL: base URL used to build the password-reset link sent by
# email (e.g. https://app.example.com/reset-password?token=...).
# APP_FRONTEND_URL=http://localhost:5173
